PORT=3500
NODE_ENV=development

DATABASE_URL="postgresql://lla:lla@localhost:5438/lla"
LOGS_DATABASE_URL="postgresql://lla_logs:lla_logs@localhost:5439/lla_logs"

JWT_SECRET="lla-jwt-secret-dev-2026-super-secure"
JWT_EXPIRES_IN="12h"

COOKIE_NAME="lla_session"
COOKIE_SECRET="lla-cookie-secret-dev-2026-super-secure"

CORS_ORIGINS="http://localhost:3501"

LOG_CONSOLE=true
LOG_LEVEL=info
LOG_REQUESTS=true
LOG_REQUESTS_SLOW_MS=500
LOG_REQUESTS_BODY=false
LOG_REQUESTS_SKIP_PATHS=/api/health

LOG_APP=true
LOG_PRISMA_QUERIES=false
LOG_SLOW_QUERY_MS=0
LOG_PRISMA_PARAMS=false

LOGS_FLUSH_INTERVAL=5000
LOGS_BATCH_SIZE=50

RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_LOGIN_MAX=10
